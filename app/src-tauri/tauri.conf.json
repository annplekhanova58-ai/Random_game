{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Random Steam Game",
  "version": "0.1.0",
  "identifier": "app.randomsteamgame.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43128",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Случайная игра Steam",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
