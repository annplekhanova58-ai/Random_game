{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Random Steam Game",
  "version": "0.1.0",
  "identifier": "app.randomsteamgame.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43128",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Случайная игра Steam",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
